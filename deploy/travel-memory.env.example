SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_URL="jdbc:mysql://127.0.0.1:3306/travel_memory?serverTimezone=Asia/Shanghai&characterEncoding=UTF-8"
DB_USERNAME=travel_memory
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
TRAVEL_UPLOAD_DIR=/var/lib/travel-memory/travel-media
PROFILE_AVATAR_UPLOAD_DIR=/var/lib/travel-memory/avatars
PROFILE_APPEARANCE_UPLOAD_DIR=/var/lib/travel-memory/appearance
TRAVEL_CHAT_UPLOAD_DIR=/var/lib/travel-memory/private-chat
TRAVEL_COLLAB_UPLOAD_DIR=/var/lib/travel-memory/private-collab
TRAVEL_VIDEO_LIBRARY_DIR=/var/lib/travel-memory/video-works
# Optional video and voice services
TRAVEL_FFMPEG_PATH=/usr/bin/ffmpeg
DOUBAO_TTS_API_KEY=
